<?xml version="1.0" encoding="UTF-8" ?>
<FlexiPage xmlns="http://soap.sforce.com/2006/04/metadata">
    <flexiPageRegions>
        <itemInstances>
            <!-- Diverging Bar Chart: Quota Variance by Lead Source (Wave 4). Free-text GraphQL record query scopes the page to [D3DEMO] seeded Opportunities; the signed Quota_Variance__c sums are aggregated client-side and straddle the zero baseline. -->
            <componentInstance>
                <componentInstanceProperties>
                    <name>graphqlQuery</name>
                    <value
          >query D3DemoQuotaVariance { uiapi { query { Opportunity(first: 2000, where: { and: [{ Name: { like: "[D3DEMO]%" } }, { Quota_Variance__c: { ne: null } }, { LeadSource: { ne: null } }] }) { edges { node { LeadSource { value } Quota_Variance__c { value } } } } } } }</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>objectApiName</name>
                    <value>Opportunity</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>groupByField</name>
                    <value>LeadSource</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>valueField</name>
                    <value>Quota_Variance__c</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>operation</name>
                    <value>Sum</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>height</name>
                    <value>350</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>advancedConfig</name>
                    <value>{}</value>
                </componentInstanceProperties>
                <componentName>d3DivergingBarChartGraphql</componentName>
                <identifier>c_d3DivergingBarChartGraphql</identifier>
            </componentInstance>
        </itemInstances>
        <name>main</name>
        <type>Region</type>
    </flexiPageRegions>
    <masterLabel>D3 GraphQL Showcase 3</masterLabel>
    <template>
        <name>flexipage:defaultAppHomeTemplate</name>
    </template>
    <type>AppPage</type>
</FlexiPage>
